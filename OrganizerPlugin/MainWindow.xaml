<Window x:Class="OrganizerPlugin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Модульный настольный органайзер"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

  <Window.Resources>

    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,2,0,2"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RangeHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#595959"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Width" Value="100"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

  </Window.Resources>

  <Grid Margin="16">

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Модульный настольный органайзер"
               FontSize="20"
               FontWeight="Bold"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <Grid Grid.Row="1">

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- СЛЕВА: только параметры и кнопки -->
      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              Padding="12">

        <Grid>

          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,0,6,0">

              <TextBlock Text="Параметры"
                         FontSize="17"
                         FontWeight="Bold"
                         Margin="0,0,0,8"/>

              <TextBlock Text="Наружная длина L, мм"/>
              <TextBox Text="300"/>
              <TextBlock Text="Допустимо: 300–331,25 мм"
                         Style="{StaticResource RangeHint}"/>

              <TextBlock Text="Наружная ширина W, мм"/>
              <TextBox Text="160"/>
              <TextBlock Text="Допустимо: 100–250 мм"
                         Style="{StaticResource RangeHint}"/>

              <TextBlock Text="Наружная высота H, мм"/>
              <TextBox Text="100"/>
              <TextBlock Text="Допустимо: 50–150 мм"
                         Style="{StaticResource RangeHint}"/>

              <TextBlock Text="Толщина элементов T, мм"/>
              <TextBox Text="5"/>
              <TextBlock Text="Допустимо: 3–10 мм"
                         Style="{StaticResource RangeHint}"/>

              <TextBlock Text="Количество секций N, шт."/>
              <TextBox Text="4"/>
              <TextBlock Text="Допустимо: целое число от 2 до 6"
                         Style="{StaticResource RangeHint}"/>

              <TextBlock Text="Ширина первых N−1 секций S, мм"
                         TextWrapping="Wrap"/>
              <TextBox Text="68,75"/>
              <TextBlock Text="Допустимо: 58,333…–68,75 мм"
                         Style="{StaticResource RangeHint}"/>

            </StackPanel>

          </ScrollViewer>

          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,8,0,0">

            <Button Content="Сбросить"
                    Margin="0,0,10,0"/>

            <Button Content="Построить"/>

          </StackPanel>

        </Grid>

      </Border>

      <!-- СПРАВА: схема, пояснение и условия -->
      <Border Grid.Column="2"
              Background="White"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              Padding="12">

        <Grid>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Справочная схема изделия"
                     FontSize="17"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10"/>

          <Image Grid.Row="1"
                 Source="/Images/organizer_drawing.png"
                 Stretch="Uniform"
                 Margin="0,4"/>

          <StackPanel Grid.Row="2"
                      Margin="0,10,0,0">

            <TextBlock TextWrapping="Wrap"
                       Foreground="#595959">
              <Run Text="Первые N−1 секций имеют внутреннюю ширину S."/>
              <LineBreak/>
              <Run Text="Последняя секция занимает оставшуюся часть внутренней длины корпуса; её ширина — от S до 100 мм."/>
            </TextBlock>

            <TextBlock Text="Условия совместимости:"
                       FontWeight="Bold"
                       Margin="0,10,0,4"/>

            <TextBlock Text="N · S + (N + 1) · T ≤ L"
                       TextWrapping="Wrap"/>

            <TextBlock Text="L ≤ (N − 1) · S + (N + 1) · T + 100"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>

          </StackPanel>

        </Grid>

      </Border>

    </Grid>

    <TextBlock Grid.Row="2"
               Text="Параметры заданы корректно. Готово к построению."
               Foreground="#237A36"
               TextWrapping="Wrap"
               Margin="0,10,0,0"/>

  </Grid>

</Window>